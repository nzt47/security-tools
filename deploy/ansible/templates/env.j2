# ════════════════════════════════════════════════════════════
# 云枢（Digital Life）环境配置 — 由 Ansible 渲染
# ════════════════════════════════════════════════════════════
# 【不易】本文件由 deploy/ansible/templates/env.j2 渲染生成
#        禁止手工编辑目标机上的 .env（会被下次部署覆盖）
#        配置修改请改 group_vars/test/vars.yml + vault.yml
# ════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────
# LLM 服务配置（唯一来源）— 密钥来自 Ansible Vault
# ────────────────────────────────────────────────────────────
LLM_PROVIDER={{ llm_provider }}
LLM_API_KEY={{ llm_api_key }}
LLM_MODEL={{ llm_model }}
LLM_BASE_URL={{ llm_base_url }}

# ────────────────────────────────────────────────────────────
# 错误上报配置
# ────────────────────────────────────────────────────────────
ERROR_REPORTING_CONSOLE_LEVEL=warning
ERROR_REPORTING_FILE_ENABLED=true
ERROR_REPORTING_FILE_PATH={{ log_path }}/digital_life_errors.log
ERROR_REPORTING_FILE_LEVEL=error

ERROR_REPORTING_WEBHOOK_ENABLED={{ 'true' if error_reporting_webhook_url else 'false' }}
ERROR_REPORTING_WEBHOOK_URL={{ error_reporting_webhook_url }}
ERROR_REPORTING_WEBHOOK_TIMEOUT=5
ERROR_REPORTING_WEBHOOK_LEVEL=error

ERROR_REPORTING_SLACK_ENABLED=false
ERROR_REPORTING_SLACK_LEVEL=warning

# ────────────────────────────────────────────────────────────
# 功能开关
# ────────────────────────────────────────────────────────────
YUNSHU_FEATURE_SANDBOX={{ 'true' if enable_sandbox else 'false' }}

# ────────────────────────────────────────────────────────────
# 日志配置
# ────────────────────────────────────────────────────────────
LOG_LEVEL={{ log_level }}

# ────────────────────────────────────────────────────────────
# GlitchTip 错误追踪平台（可选）
# ────────────────────────────────────────────────────────────
GLITCHTIP_ADMIN_PASSWORD={{ glitchtip_admin_password }}
GLITCHTIP_ADMIN_EMAIL={{ glitchtip_admin_email }}
GLITCHTIP_DOMAIN={{ glitchtip_domain }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
SECRET_KEY={{ secret_key }}

# ────────────────────────────────────────────────────────────
# 搜索引擎 API Keys — 密钥来自 Ansible Vault
# ────────────────────────────────────────────────────────────
SEARCH_FIRECRAWL_API_KEY={{ search_firecrawl_api_key }}
SEARCH_TAVILY_API_KEY={{ search_tavily_api_key }}
SEARCH_BING_API_KEY={{ search_bing_api_key }}
SEARCH_GOOGLE_API_KEY={{ search_google_api_key }}

# ────────────────────────────────────────────────────────────
# P3 离线模型配置
# ────────────────────────────────────────────────────────────
HF_HUB_OFFLINE={{ hf_hub_offline }}
TRANSFORMERS_OFFLINE={{ transformers_offline }}

# ────────────────────────────────────────────────────────────
# Hybrid 检索配置（tool_router_hybrid.py）
# 【不易】降级链路不得弱化：EMBEDDING=1 守 0xC0000005 崩溃隔离
# ────────────────────────────────────────────────────────────
AGENT_HYBRID_EMBEDDING={{ agent_hybrid_embedding }}
AGENT_HYBRID_RERANKER={{ agent_hybrid_reranker }}
AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGENT_RERANKER_TOP_N=20
AGENT_RERANKER_MIN_SCORE=0.05

# ────────────────────────────────────────────────────────────
# v6.5 Skill Reranker 配置
# 【不易】ONNX 量化推理为生产推荐路径（P99 258ms）
# ────────────────────────────────────────────────────────────
SKILL_RERANKER_ENABLED={{ skill_reranker_enabled }}
{% if skill_reranker_model %}
SKILL_RERANKER_MODEL={{ skill_reranker_model }}
{% endif %}
SKILL_RERANKER_TIMEOUT=30
SKILL_RERANKER_MIN_SCORE=0.001
SKILL_RERANKER_USE_ONNX={{ skill_reranker_use_onnx }}
SKILL_RERANKER_ONNX_VARIANT={{ skill_reranker_onnx_variant }}
