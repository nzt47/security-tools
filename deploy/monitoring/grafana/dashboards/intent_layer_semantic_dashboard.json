    {
      "title": "低分 skill 异常日志（skill_id / top1_score < 0.3）",
      "description": "过滤 top1_score < 0.3 的命中日志，展示 skill_id 与 score，辅助误召回排查（字段 3/4）",
      "type": "logs",
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "$datasource"
          },
          "expr": "{job=\"yunshu-orchestrator\", action=\"orchestrator.semantic.metric_total\"} | regexp \"semantic\\\\[total=(?P<total>[0-9.]+)\\\\]\\\\[skill=(?P<skill>\\\\S+)\\\\]\\\\[score=(?P<score>[0-9.]+)\" | score < 0.3 | line_format \"skill={{.skill}} | score={{.score}} | {{__line__}}\"",
          "legendFormat": "{{skill}}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
