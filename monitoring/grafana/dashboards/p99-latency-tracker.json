  "description": "P99 延迟持续追踪面板 — 生产环境 SLO 监控专用\n基准线: 32ms (集群内直连压测实测) | SLO 阈值: 40ms (HPA 扩容触发)\n告警: P99 > 35ms (warning) / P99 > 40ms (critical)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "title": "P99 延迟趋势 (基准 32ms / SLO 40ms)",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 32},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 40}
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[1m])) by (le))",
          "legendFormat": "P99 (全集群)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[5m])) by (le))",
          "legendFormat": "P99 (5m 平滑)",
          "refId": "B"
        }
      ],
      "thresholds": [
        {"colorMode": "warning", "op": "gt", "value": 32, "fill": false, "line": true, "yaxis": "left"},
        {"colorMode": "critical", "op": "gt", "value": 40, "fill": true, "line": true, "yaxis": "left"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "title": "延迟百分位分布 (P50/P90/P95/P99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 40}
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[1m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[1m])) by (le))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[1m])) by (le))",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\"}[1m])) by (le))",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "thresholds": [
        {"colorMode": "critical", "op": "gt", "value": 40, "fill": false, "line": true, "yaxis": "left"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "title": "P99 SLO 合规率 (目标 >99% 时间低于 40ms)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.95},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.999}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(skill_match_latency_ms_bucket{namespace=\"$namespace\",le=\"40.0\"}[5m])) / sum(rate(skill_match_latency_ms_count{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "P99 SLO 合规率",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
