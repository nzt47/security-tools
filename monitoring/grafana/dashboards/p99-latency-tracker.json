      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 32},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 40}
