            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(yunshu_intent_layer_total{layer=\"llm_low_confidence_fallback\"}[5m])) / on() sum(rate(yunshu_intent_layer_total{layer=\"llm\"}[5m]))",
