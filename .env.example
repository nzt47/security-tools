# Digital Life 环境变量配置示例
# 复制此文件为 .env 并填入真实配置

# ========================================
# LLM 服务配置（唯一来源；.env 含真实 key，禁止提交，见 .gitignore）
# ========================================
# 提供商: openai / anthropic / siliconflow / ollama / DeepSeek
# 注意: LLMService 兼容表仅含小写 "deepseek"，provider 请用小写 deepseek
#       （大写 DeepSeek 会触发 "不支持的 provider" 错误）
LLM_PROVIDER=deepseek

# API Key（填入实际使用的 LLM key；格式 sk- 开头、长度>=20）
# 并行会话曾覆盖为 sk-test/sk-secret 等占位 key 导致启动失败，
# 可用 scripts/guard_llm_api_key.py --check --restore 自动检测并恢复
LLM_API_KEY=sk-your-real-key-here

# 模型名称（DeepSeek 官方: deepseek-chat / deepseek-reasoner；
# 注意 deepseek-v4-flash 不存在 → 404）
LLM_MODEL=deepseek-chat

# API 端点（OpenAI 兼容格式）
# DeepSeek OpenAI 兼容端点必须用 /v1（/anthropic 端点需 anthropic SDK，
# 本服务用 openai SDK 会 404）
# OpenAI: https://api.openai.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1
# Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# ========================================
# 错误上报配置
# ========================================

# 控制台上报
ERROR_REPORTING_CONSOLE_LEVEL=warning

# 文件上报
ERROR_REPORTING_FILE_ENABLED=true
ERROR_REPORTING_FILE_PATH=./logs/digital_life_errors.log
ERROR_REPORTING_FILE_LEVEL=error

# Webhook 上报（可选）
ERROR_REPORTING_WEBHOOK_ENABLED=false
ERROR_REPORTING_WEBHOOK_URL=https://your-webhook-url.com/endpoint
ERROR_REPORTING_WEBHOOK_TIMEOUT=5
ERROR_REPORTING_WEBHOOK_LEVEL=error

# Slack 上报（可选）
ERROR_REPORTING_SLACK_ENABLED=false
ERROR_REPORTING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ERROR_REPORTING_SLACK_CHANNEL=#digital-life-alerts
ERROR_REPORTING_SLACK_USERNAME=Digital Life Bot
ERROR_REPORTING_SLACK_ICON=:robot_face:
ERROR_REPORTING_SLACK_LEVEL=warning

# ========================================
# 功能开关
# ========================================

# Python 沙盒功能（默认关闭，设置为 true 启用）
YUNSHU_FEATURE_SANDBOX=false

# ========================================
# 规则层关键词外置（追加合并，单一数据源）
# ========================================
# 规则层(WorkflowEngine)关键词通过 ORCHESTRATOR_RULE_KEYWORDS_<规则名> 配置。
# 语义: 与 builtin_rules.py 默认关键词【追加合并去重】(非覆盖)，
#       env 值用英文逗号分隔多条关键词；留空/未配置则使用默认值兜底。
# 完整默认关键词请参阅 agent/workflow_engine/builtin_rules.py
ORCHESTRATOR_RULE_KEYWORDS_CHECK_TIME=现在几点了
ORCHESTRATOR_RULE_KEYWORDS_CHECK_DATE=今天几号
ORCHESTRATOR_RULE_KEYWORDS_CHECK_HEALTH=你好呀
ORCHESTRATOR_RULE_KEYWORDS_GREETING=早上好
ORCHESTRATOR_RULE_KEYWORDS_THANKS=谢谢啦
ORCHESTRATOR_RULE_KEYWORDS_FAREWELL=拜拜
ORCHESTRATOR_RULE_KEYWORDS_CONFIRMATION=没问题

# ========================================
# 日志配置
# ========================================
# LOG_LEVEL: 全局日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
#   DEBUG  = 详细日志（含 ContextAssembler 三层组装 l0./l1./l2. 埋点，排查问题用）
#   INFO   = 默认（生产推荐）
# 优先级: --debug 命令行参数 > LOG_LEVEL 环境变量 > 默认 INFO
# 影响: agent.memory.context_assembler 的 assemble.entry/exit、l0.built、l1.built、l2.built 等埋点
LOG_LEVEL=INFO

# ========================================
# 其他配置（根据需要添加）
# ========================================

# ========================================
# GlitchTip 错误追踪平台配置
# ========================================
# 用于 docker/glitchtip/docker-compose.yml + orm_setup_inline.py
# 启动方式: cd docker/glitchtip && cp .env.example .env && docker compose up -d

# GlitchTip 管理员密码（orm_setup_inline.py 读取，缺失即终止）
# 生产环境请使用强密码（>=12 字符，含大小写+数字+符号）
GLITCHTIP_ADMIN_PASSWORD=

# GlitchTip 管理员邮箱（默认 admin@local.test，可自定义）
GLITCHTIP_ADMIN_EMAIL=admin@local.test

# GlitchTip 访问域名（docker-compose.yml 已有默认值）
GLITCHTIP_DOMAIN=http://localhost:8000

# PostgreSQL 数据库配置（docker-compose.yml 已有默认值）
POSTGRES_DB=glitchtip
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=glitchtip_dev_pass

# Django SECRET_KEY（生产环境务必修改）
SECRET_KEY=dev-secret-key-change-in-production

# ========================================
# P3 离线模型配置（predownload_model.py 生成）
# ========================================
# 预下载模型后启用离线模式，避免运行时网络请求
# 启用前需先运行: python scripts/predownload_model.py --all
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========================================
# Hybrid 检索配置（tool_router_hybrid.py）
# ========================================
# AGENT_HYBRID_EMBEDDING: Embedding 子进程隔离开关
#   1=启用（子进程探测 + 0xC0000005 崩溃隔离，推荐）
#   0=禁用（纯 BM25）
#   未设置=走子进程探测（默认行为，首次启动有探测开销）
# 探测结果缓存: data/.embedding_probe（删除可强制重新探测）
AGENT_HYBRID_EMBEDDING=1

# AGENT_HYBRID_RERANKER: Cross-Encoder 精排开关
#   1=启用（Phase 2 微调后推荐）
#   0=禁用（Phase 1 零样本评估，默认，避免影响生产）
AGENT_HYBRID_RERANKER=0

# Cross-Encoder 模型（零样本用基础模型，Phase 2 微调后改为微调路径）
AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Stage 2 精排候选数（从 BM25 top-N 中精排，默认 20）
AGENT_RERANKER_TOP_N=20
# rerank_score 阈值，低于此值的候选剔除（默认 0.05）
AGENT_RERANKER_MIN_SCORE=0.05

# ========================================
# v6.5 Skill Reranker 配置（agent/skills_mgmt/reranker.py）
# ========================================
# 说明：v6.5 SkillReranker 类独立读取 SKILL_RERANKER_* 前缀环境变量
# 与上方 AGENT_RERANKER_* 历史配置并存，互不影响
# 启用开关（true/false，默认 true）
# 2026-07-28 ONNX 量化方案落地：jina-reranker-v2 quantized ONNX 实测 P99 258ms（vs PyTorch 7960ms，30.8x 加速）
# 历程：v2-m3 P99 4.6s ❌ → jina PyTorch P99 7.96s ❌ → ONNX quantized P99 258ms ✅ → 启用 ONNX 推理
# 推理后端优先级：ONNX（C++ 引擎）→ PyTorch（降级）→ RRF（最终降级）
SKILL_RERANKER_ENABLED=true
# Cross-Encoder 模型名（本地路径，必须指向含 onnx/ 子目录的模型目录）
# 默认 jinaai/jina-reranker-v2-base-multilingual（~280MB，含预导出 7 种 ONNX 格式）
# 备选 BAAI/bge-reranker-base（~1.1GB，CPU 优先测试，下载见 scripts/download_bge_reranker_base_modelscope.py）
# 备选 BAAI/bge-reranker-v2-m3（~2.3GB，CPU P99 4.6s 需调大 RERANK_TIMEOUT，下载见 scripts/download_bge_reranker_v2_m3_modelscope.py）
# 选型详见：docs/RERANKER_BGE_V2_M3_INTEGRATION_TODO.md
SKILL_RERANKER_MODEL=C:/Users/Administrator/.cache/huggingface/hub/models--jinaai--jina-reranker-v2-base-multilingual
# 子进程超时秒数（默认 30，仅 PyTorch 路径用；ONNX 路径 P99 258ms 远低于此值）
SKILL_RERANKER_TIMEOUT=30
# 单次 rerank predict 超时秒数（默认 3.0，超时后降级返回原序不抛异常）
# 【变易】与 TIMEOUT（子进程超时 30s）区分：RERANK_TIMEOUT 聚焦单次推理延迟
# ONNX 量化路径 P99 258ms 远低于此值；PyTorch 路径或大模型（bge 系列）需调大
# 调整建议：
#   - jina ONNX quantized（P99 258ms）→ 3.0（默认，无需改）
#   - bge-reranker-base ONNX（待测）→ 若 P99>3s 调到 5.0
#   - bge-reranker-v2-m3 PyTorch（P99 4.6s）→ 6.0（或换 ONNX 量化版）
# 权衡：调大会阻塞主流程更久，但避免降级损失精度（降级返回 RRF 原序，reranker 失效）
SKILL_RERANKER_RERANK_TIMEOUT=3.0
# 最低分数阈值，低于此值的候选剔除（默认 0.001）
SKILL_RERANKER_MIN_SCORE=0.001
# ONNX 推理开关（true/false，默认 true）
# 启用后优先加载 <model_dir>/onnx/<variant>，失败降级到 PyTorch
# 关闭则强制走 PyTorch 路径（仅用于排查或 A/B 对比）
SKILL_RERANKER_USE_ONNX=true
# ONNX 变体文件名（默认 model_quantized.onnx）
# 可选值：model_quantized.onnx (P99 258ms ✅最优) / model_int8.onnx (P99 363ms) /
#         model_q4.onnx (P99 302ms) / model_uint8.onnx (P99 439ms) /
#         model_bnb4.onnx (P99 465ms) / model.onnx (P99 505ms ❌) / model_fp16.onnx (P99 622ms ❌)
# 详见：docs/V65_ONNX_QUANTIZATION_PLAN.md §0.3.1
SKILL_RERANKER_ONNX_VARIANT=model_quantized.onnx

# ========================================
# 安全护栏与人机协同配置（agent/skills_mgmt/approval.py | rollback.py |
# value_guard.py，任务 EVO-T6）
# ========================================
# 全部带默认值，可留空走默认
# ---- 统一审批流（approval.py）----
# 审批总开关（1=开启，0=关闭。关闭时 L1/L2 变更直接放行——无人类监督，
# 构造期会输出醒目告警并留档；安全第一，默认开启）
APPROVAL_ENABLED=1
# 审批记录 JSONL 路径（默认 agent/data/approval_records.jsonl）
APPROVAL_RECORDS_PATH=agent/data/approval_records.jsonl
# ---- 自动回滚（rollback.py）----
# 单对象单日回滚次数上限（超限熔断该对象自动进化并告警，默认 2）
ROLLBACK_MAX_DAILY=2
# 成功率相对下降阈值（%，默认 20）
ROLLBACK_SUCCESS_DROP_PCT=20
# P95 延迟相对上升阈值（%，默认 50）
ROLLBACK_LATENCY_RISE_PCT=50
# 运行时异常率相对上升阈值（%，默认 50）
ROLLBACK_ERROR_RISE_PCT=50
# 评估窗口（分钟，默认 1440 = 1 天）
ROLLBACK_WINDOW_MIN=1440
# 回滚状态 JSONL 路径（默认 agent/data/rollback_state.jsonl）
ROLLBACK_STATE_PATH=agent/data/rollback_state.jsonl
# ---- 价值观红线（value_guard.py）----
# 红线检查总开关（1=开启，0=关闭。关闭时进化产物不过价值观红线，
# 构造期会输出醒目告警；默认开启）
VALUE_GUARD_ENABLED=1
# LLM 辅助检查开关（0=仅规则引擎，默认 0；开启后规则不命中时用 LLM 复核）
VALUE_GUARD_LLM_ENABLED=0
# 外部规则 JSON 文件路径（空=仅内置规则；新规则走该文件，禁止硬编码）
VALUE_GUARD_RULES_PATH=

# ========================================
# 上下文与知识进化闭环配置（agent/cognitive/prompt_optimizer.py，
# agent/knowledge/distill_feedback.py，任务 EVO-T4）
# ========================================
# 全部带默认值，可留空走默认
# 提示词自优化：建议版相对提升阈值（默认 0.03 = 3%）
PROMPT_OPT_THRESHOLD=0.03
# 提示词自优化：变体数上限（默认 3；任务要求 2-3）
PROMPT_OPT_MAX_VARIANTS=3
# 提示词绝对验证（蒸馏/反思无基线场景）最低接受分（默认 0.5）
PROMPT_OPT_ABS_MIN_SCORE=0.5
# 反思 Lesson 可验证类别（逗号分隔；默认 general,analyze,query）
REFLECTOR_LESSON_VERIFIABLE_TYPES=general,analyze,query
# 蒸馏反馈回路：失败模式最低出现频次（默认 2）
DISTILL_FEEDBACK_MIN_FREQUENCY=2
# 蒸馏反馈回路：每类聚合条数上限（默认 3）
DISTILL_FEEDBACK_TOP_N=3
# 蒸馏反馈回路：汇总周期窗口（天，默认 7）
DISTILL_FEEDBACK_INTERVAL_DAYS=7
# 提示词自优化：服务端失败桶阈值（连续失败达该次数才上报带 prompt_id 的指标，降基数；默认 3）
PROMPT_OPT_FAILURE_BUCKET=3
# 失败桶存储后端：memory（默认，进程内）| redis（跨重启/多副本聚合，不可用自动降级内存）
PROMPT_OPT_FAILURE_STORE=memory
# Redis 连接串（仅 PROMPT_OPT_FAILURE_STORE=redis 时使用）
REDIS_URL=redis://localhost:6379/0
# 失败计数键 TTL（秒，默认 86400 = 1 天；防长期失败键滞留）
PROMPT_OPT_FAILURE_TTL=86400

# ========================================
# 工具进化升级·元智能体受控编辑配置（agent/skills_mgmt/edit_policy.py，
# agent/skills_mgmt/meta_editor.py，任务 EVO-T5）
# ========================================
# 全部带默认值，可留空走默认
# 白名单目录（逗号分隔，相对项目根）——元智能体仅可编辑这些目录内的技能内容/文档
META_EDIT_WHITELIST_DIRS=data/skills_repo
# 单个提案最大文件数 N（默认 1）
META_EDIT_MAX_FILES_PER_ROUND=1
# 单轮可编辑技能数 N（默认 1）
META_EDIT_MAX_SKILLS_PER_ROUND=1
# 单轮 token 预算（默认 50000；0=不熔断，复用任务 3 成本控制口径）
META_EDIT_MAX_TOKENS_PER_ROUND=50000
# 连续 K 轮无提升暂停该技能进化（默认 3，防无效迭代烧钱）
META_EDIT_STALL_ROUNDS=3
# 评估通过阈值（默认 0.3，与 EVAL_STAGE1_MIN_SCORE 同口径）
META_EDIT_EVAL_MIN_SCORE=0.3
# 内容黑名单正则（逗号分隔，追加到内置默认；禁危险代码/注入痕迹）
META_EDIT_BLOCKED_PATTERNS=

# ========================================
# 技能评估集工程化与回归门禁（任务1：自进化机制重构计划 · 阶段一）
# agent/skills_mgmt/eval_regression.py + eval_sample_ingest.py + scripts/eval_samples_validate.py
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml skills_mgmt.eval_samples > 硬编码默认
# 扩充管道总开关（安全底线，默认 false：零副作用；true 时只产 data/evals/_pending/ DRAFT，
# 审核通过（reviewer 安全扫描）才入正式类别 JSON，绝不直接写评估集）
EVAL_SAMPLE_INGEST_ENABLED=false
# DRAFT 草稿目录（默认 ./data/evals/_pending）
EVAL_SAMPLE_PENDING_DIR=./data/evals/_pending
# 样本集版本登记文件（版本 → 类别 → 样本 id 清单；默认 ./data/evals/manifest.json）
EVAL_SAMPLESET_MANIFEST=./data/evals/manifest.json
# 回归基线存储（skill_id → 版本 → 基线分；默认 ./data/evals/baselines.json）
EVAL_REGRESSION_BASELINE_FILE=./data/evals/baselines.json
# 回归门禁默认样本集版本（默认 v1）
EVAL_REGRESSION_DEFAULT_SET=v1
# 回归退化阈值（delta < -0.05 → FAIL，默认 0.05）
EVAL_REGRESSION_DEGRADE_THRESHOLD=0.05
# 门禁单次评估 token 预算（TokenBudget 熔断，默认 100000）
EVAL_REGRESSION_BUDGET_TOKENS=100000
# 进化提交回归门禁模式（off / warn_only / enforce；默认 warn_only 只读告警不拦截，
# enforce 才拦截 FAIL/NO_SAMPLES/budget_exceeded → 谱系 rejected 并跳过提交）
EVOLUTION_REGRESSION_GATE=warn_only

# ========================================
# 感知侧新颖性学习管线配置（sensor/novelty.py、agent/learning/novelty_hooks.py、
# agent/learning/behavior_drift.py，任务 TASK-06）
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml learning.sensor_learning > 硬编码默认
# 总开关（默认 false 观察模式——2026-08-15 正式采集验证后恢复；false：全链路零学习副作用；
# true 分级沉淀：低/中置信→记忆，高置信→审计+建议草稿 DRAFT，绝不注册技能）
SENSOR_LEARNING_ENABLED=false
# 行为漂移判定阈值（周级基线相对偏差均值，默认 0.3）
SENSOR_LEARNING_DRIFT_THRESHOLD=0.3
# 行为基线保留周数（~/.Yunshu/baselines/behavior_<周一日期>.json 滚动清理，默认 8）
SENSOR_LEARNING_BASELINE_RETENTION_WEEKS=8
# change_log.json 容量上限（~/.Yunshu/changes/，超出滚动删除最旧，默认 10000）
SENSOR_LEARNING_CHANGE_LOG_MAX_ENTRIES=10000
# 建议草稿目录（高置信事件，仅 DRAFT，供 TASK-04 审核链消费）
SENSOR_LEARNING_DRAFT_DIR=./data/learning/novelty_suggestions
# 学习审计日志（JSONL：事件分类/分级/落点）
SENSOR_LEARNING_AUDIT_FILE=./data/learning/novelty_audit.jsonl
# 事件记忆目录（JSONL：novelty_memory.jsonl，event=novelty_event 标签）
SENSOR_LEARNING_MEMORY_DIR=./data/learning/novelty_memory

# ========================================
# 窗口监控传感器（sensor/window_sensor.py）
# ========================================
# 默认不设置（自动初始化，强制 disabled，需 /api/window/consent 同意后才启用）。
# 开发/沙箱环境屏蔽导入：设为 1 或 true 时 app_server 跳过 from sensor.window_sensor import
# （规避受限环境对系统语音词库等路径的访问噪音；注意：屏蔽后窗口监控功能不可用）
YUNSHU_DISABLE_WINDOW_SENSOR=

# ========================================
# 轻量自我进化机制配置（agent/evolution/，任务6）
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml learning.evolution > 硬编码默认
# 总开关（默认 true；false 时注入器返回空，进化闭环停用）
EVOLUTION_ENABLED=true
# 可选 LLM 候选生成（默认 true；无 LLM 环境自动降级为规则候选，不阻塞）
EVOLUTION_LLM_GENERATE=true
# 策略库/失败案例存储目录（默认 ./data/evolution）
EVOLUTION_STORAGE_PATH=./data/evolution

# ========================================
# 学习 KPI 触发监控配置（agent/learning_metrics.py，任务2 重构计划阶段一）
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml learning.metrics > 硬编码默认
# KPI#7 最小候选基数（周候选数 < 该值时该周采纳率标记 insufficient_data，不参与"连续 4 周"
# 统计；默认 5）
LEARNING_METRICS_MIN_CANDIDATES=5
# 知识检索（agent/knowledge/search.py）KPI#1 语义查询观察埋点（默认 false 观察模式关；
# true 时每次 KnowledgeSearch.search 计入 record_semantic_query，saved_tokens=0 不改复用率口径）
LEARNING_METRICS_OBSERVE_KNOWLEDGE_SEARCH=false
# SQLite 持久化（默认关；true 灰度开启后跨重启累积"连续 4 周"统计，I/O 不进锁、DB 失败自动
# 降级为内存聚合；等价于 config.yaml learning.metrics.persistence.enabled=true）
LEARNING_METRICS_PERSIST_ENABLED=false
# 持久化 DB 路径（默认 data/learning_metrics.db）
LEARNING_METRICS_PERSIST_PATH=./data/learning_metrics.db
# 达该事件行数阈值自动批量落库（单事务，默认 200）
LEARNING_METRICS_PERSIST_FLUSH_BATCH=200
# 回填保留天数（跨重启恢复窗口，默认 90）
LEARNING_METRICS_PERSIST_RETENTION_DAYS=90
# 触发条件判定窗口周数（"连续 4 周"判定窗口，默认 4）
LEARNING_METRICS_TRIGGER_WINDOW_WEEKS=4
# 沙箱回放覆盖率阈值（TC-4：< 该值且 KPI#6 停滞才触发；默认 0.5）
LEARNING_METRICS_REPLAY_COVERAGE_THRESHOLD=0.5

# ========================================
# 元规则版本化与护栏状态配置（agent/learning/meta_policy.py +
# agent/learning/guard_status.py，任务4 重构计划阶段二，护栏 G1）
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml learning.meta_policy > 硬编码默认
# 元规则存储/变更总开关（默认 true；false 时变更操作（bump/rollback/migrate-apply）
# 全部拒绝，只读查询可用——守"元规则存储只读默认"）
META_POLICY_ENABLED=true
# 存储根目录（schema.json / current.json / versions/vN.json / pending.json / audit.jsonl）
META_POLICY_STORE_DIR=./data/learning/meta_policy
# 变更审批级别（L0/L1/L2；默认 L1=人工批准后系统自动生效；L2=人工执行）
META_POLICY_APPROVAL_LEVEL=L1
# 审计 JSONL 路径（G3 字段：change_id/param/old/new/approver/rollback_command）
META_POLICY_AUDIT_FILE=./data/learning/meta_policy/audit.jsonl
# migrate 只做 dry-run（默认 true，安全底线：不迁移任何参数，仅报告差异）
META_POLICY_MIGRATE_DRY_RUN_ONLY=true
# 护栏状态服务总开关（默认 true；false 时 /api/learning/guards 返回关闭态）
GUARD_STATUS_ENABLED=true

# ========================================
# L2 自进化闭环受控放行配置（agent/learning/rollout_controller.py，任务3 重构计划阶段二）
# ========================================
# 全部带默认值，可留空走默认；优先级 env > config.yaml learning.rollout > 硬编码默认
# 一键总开关（默认 false：关闭时全部动作强制 dry_run，零提交——安全底线）
LEARNING_ROLLOUT_MASTER_ENABLED=false
# 放行审计 JSONL（action/mode/candidate_id/decision/版本号/回归结果/KPI 快照/回滚命令）
LEARNING_ROLLOUT_AUDIT_FILE=./data/learning/rollout_audit.jsonl
# 回归门禁模式（enforce=FAIL/NO_SAMPLES 拦截提交 / warn_only=只读告警 / off=零调用；默认 enforce）
LEARNING_ROLLOUT_REGRESSION_GATE=enforce
# 各动作放行模式（dry_run/observe/confirm/rollout；ACTION=FEEDBACK|EVOLUTION|LIFECYCLE）
LEARNING_ROLLOUT_FEEDBACK_MODE=dry_run
LEARNING_ROLLOUT_EVOLUTION_MODE=dry_run
LEARNING_ROLLOUT_LIFECYCLE_MODE=dry_run
# rollout 命中比例（0-1，默认 0.1）
LEARNING_ROLLOUT_FEEDBACK_ROLLOUT_RATIO=0.1
LEARNING_ROLLOUT_EVOLUTION_ROLLOUT_RATIO=0.1
LEARNING_ROLLOUT_LIFECYCLE_ROLLOUT_RATIO=0.1
# KPI 连续恶化回退窗口（周，默认 2；任一 KPI 连续 N 周恶化 → 自动回退 + 告警）
LEARNING_ROLLOUT_FEEDBACK_KPI_ROLLBACK_WINDOW_WEEKS=2
LEARNING_ROLLOUT_EVOLUTION_KPI_ROLLBACK_WINDOW_WEEKS=2
LEARNING_ROLLOUT_LIFECYCLE_KPI_ROLLBACK_WINDOW_WEEKS=2

# ========================================
# 审计日志告警配置（scripts/analyze_audit_logs.py）
# ========================================
# 告警阈值：某租户异常请求占比（status != 'success'）超过该百分比触发邮件（默认 5）
# 解析优先级：CLI --alert-threshold > 本环境变量 > 默认 5
AUDIT_ALERT_THRESHOLD=5

# SMTP 发送（发信需要以下全部；未配置时告警仅打印到控制台，不发送邮件）
# 以下示例对应 GitHub Secrets 7 项（SMTP_HOST/PORT/USER/PASS/TO/SSL、AUDIT_ALERT_THRESHOLD）
# SMTP 服务器地址：QQ 邮箱 smtp.qq.com / 企业邮箱 smtp.exmail.qq.com
# 本地联调可用 127.0.0.1 指向本地捕获服务器（scripts/dev/smtp_capture_server.py）
SMTP_HOST=smtp.qq.com
# 端口：SSL 默认 465；STARTTLS 用 587；本地联调捕获服务器可用 2525
SMTP_PORT=465
# 认证账号（QQ 邮箱为完整邮箱地址；SMTP 无需登录时可留空）
SMTP_USER=your-qq-number@qq.com
# 认证密码（应用专用密码/授权码，勿用登录密码明文；QQ：设置→账户→开启 SMTP 生成）
SMTP_PASS=your-16-digit-auth-code
# 收件人（逗号分隔可多收件人；示例）
SMTP_TO=ops@example.com
# 发件人（留空则用 SMTP_USER）
SMTP_FROM=
# 是否使用 SSL（1=SSL，0=STARTTLS/明文；本地联调捕获服务器设为 0）
SMTP_SSL=1
