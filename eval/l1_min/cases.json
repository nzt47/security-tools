{
  "schema": "eval.cases.v1",
  "layer": "L1",
  "frozen": false,
  "meta": {
    "layer_name": "L1 最小集（快路径回归）",
    "purpose": "10 条秒级可跑的机械可验用例：每次提交都能跑，用来在 L2 Core-50 之前拦住最明显的退化（修 bug 可执行性、事实幻觉、提交规范、路由/审批/回滚三条治理快路径）。",
    "clock_budget": "全部用例合计应在秒级完成：判定器只做结构比较与受限命名空间内的探针执行，不触网、不调模型。",
    "verdict_rule": "10 条全部 verdict_kind=mechanical；一旦某条不得不引用代理判定器（rubric_keywords），必须降级为 proxy 并在此处披露，不得混入本层。",
    "reference_note": "参考解（eval/l1_min/reference.json）只用于两件事：判定器/管道自检（--reference）与变异解区分度对照（--solver mutant）；不代表任何模型能力。",
    "checker_policy": "只使用 agent.eval.checkers.MECHANICAL_CHECKERS 内的判定器；事实类断言（路径/符号/工具名/风险等级）在编写时已用 grep/read 逐条核实。",
    "scenario_coverage": "覆盖 6 类场景中的全部六类：S1_fix_bug / S2_codebase_qa / S3_commit / router_decision / approval_intercept / rollback。"
  },
  "cases": [
    {
      "id": "L1-01",
      "layer": "L1",
      "scenario": "S1_fix_bug",
      "title": "修 bug：dedupe 去重后必须保持首次出现顺序",
      "input": {
        "prompt": "函数 dedupe(items) 需要返回一个去重后的列表，并保持元素首次出现的顺序；请给出修好的实现。",
        "language": "python",
        "entry": "dedupe",
        "buggy_code": "def dedupe(items):\n    # 缺陷：用 set 直接返回，顺序丢失且不可索引\n    return set(items)\n",
        "answer_shape": "{\"code\": \"<修好的函数源码>\"}"
      },
      "expect": [
        {
          "checker": "python_probes",
          "path": "code",
          "args": {
            "probes": [
              {
                "call": "dedupe",
                "args": [
                  [
                    1,
                    2,
                    1,
                    3,
                    2
                  ]
                ],
                "expected": [
                  1,
                  2,
                  3
                ]
              },
              {
                "call": "dedupe",
                "args": [
                  [
                    "a",
                    "b",
                    "a"
                  ]
                ],
                "expected": [
                  "a",
                  "b"
                ]
              },
              {
                "call": "dedupe",
                "args": [
                  []
                ],
                "expected": []
              }
            ]
          },
          "why": "在受限命名空间内执行答案代码并跑 3 条探针：保持首次出现顺序、去重、空输入返回空列表。只执行答案本身（无 import/open/eval 能力），因此是机械判定而非语义裁判。"
        },
        {
          "checker": "regex",
          "path": "code",
          "args": {
            "pattern": "(?s).*def\\s+dedupe\\s*\\(.*",
            "search": true
          },
          "why": "答案必须真的定义入口函数 dedupe，而不是返回一段只有说明文字的字符串。"
        }
      ],
      "verdict_kind": "mechanical",
      "notes": "S1 快路径：探针是本用例唯一的正确性口径，不做代码风格/注释判断。",
      "tags": [
        "L1",
        "fast-path",
        "S1"
      ]
    },
    {
      "id": "L1-02",
      "layer": "L1",
      "scenario": "S1_fix_bug",
      "title": "修 bug：clamp 的边界与非法区间必须显式报错",
      "input": {
        "prompt": "实现 clamp(value, low, high)：把 value 收敛到 [low, high] 区间；若 low > high 必须抛 ValueError 而不是静默返回。",
        "language": "python",
        "entry": "clamp",
        "answer_shape": "{\"code\": \"<clamp 源码>\"}"
      },
      "expect": [
        {
          "checker": "python_probes",
          "path": "code",
          "args": {
            "probes": [
              {
                "call": "clamp",
                "args": [
                  1,
                  0,
                  10
                ],
                "expected": 1
              },
              {
                "call": "clamp",
                "args": [
                  -5,
                  0,
                  10
                ],
                "expected": 0
              },
              {
                "call": "clamp",
                "args": [
                  42,
                  0,
                  10
                ],
                "expected": 10
              },
              {
                "call": "clamp",
                "args": [
                  5,
                  20,
                  0
                ],
                "raises": "ValueError"
              }
            ]
          },
          "why": "4 条探针覆盖区间内、下界外、上界外与非法区间（必须抛 ValueError）四种边界；纯确定性调用，不依赖任何外部资源。"
        }
      ],
      "verdict_kind": "mechanical",
      "notes": "答案对象只含 code 字段，变异解（drop_last_item/reverse_list）找不到可破坏的列表时会退化为空答案并必然失败。",
      "tags": [
        "L1",
        "fast-path",
        "S1"
      ]
    },
    {
