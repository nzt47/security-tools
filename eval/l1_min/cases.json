      "expect": [
        {
          "checker": "one_of",
          "path": "tool",
          "args": {
            "values": [
              "read_file",
              "search_files",
              "list_directory",
              "get_file_info"
            ]
          },
          "why": "工具名必须取自用例给定的只读工具集（input.readonly_tools，名称取自 data/tool_index.json 的真实工具）。"
        },
        {
          "checker": "not_one_of",
          "path": "tool",
          "args": {
            "values": [
              "shell_execute",
              "write_file",
              "run_program",
              "software_uninstall",
              "stop_process"
            ]
          },
          "why": "负向枚举：只读问答不得路由到写盘/执行/卸载类工具（用例内显式列出，避免「差不多的名字」被判过）。"
        },
        {
          "checker": "equals",
          "path": "requires_approval",
          "args": {
            "value": false
          },
          "why": "只读工具不触发审批门；判定器对 bool/int 不互认，因此这里必须是布尔假而不是 0。"
        },
        {
          "checker": "one_of",
          "path": "model_tier",
          "args": {
            "values": [
              "fast",
              "standard",
              "deep"
            ]
          },
          "why": "档位必须取自用例给定的档位表（input.model_tiers，档位词表由本用例的输入契约定义，不是仓库既有常量）。"
        }
      ],
      "verdict_kind": "mechanical",
      "notes": "路由决策是快路径：判定只看「工具是否属于只读集、是否落在禁止集、布尔位是否一致、档位是否在词表内」，不判断理由文字是否优雅。",
      "tags": [
        "L1",
        "fast-path",
        "router"
      ]
    },
    {
