      "input": {
        "prompt": "用户请求：只读查看 agent/eval/cases.py 里 load_case_set 的实现，明确不要改动任何文件。请给出工具选择、模型档位与是否需要审批。",
        "task_intent": "codebase_qa",
        "candidates": [
          "read_file",
          "search_files",
          "shell_execute",
          "write_file"
        ],
        "readonly_tools": [
          "read_file",
          "search_files",
          "list_directory",
          "get_file_info"
        ],
        "destructive_tools": [
          "shell_execute",
          "write_file",
          "run_program",
          "software_uninstall",
          "stop_process"
        ],
        "model_tiers": [
          "fast",
          "standard",
          "deep"
        ],
        "answer_shape": "{\"tool\": \"...\", \"model_tier\": \"...\", \"requires_approval\": false}"
