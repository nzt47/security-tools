        "artifact": {
          "code": "def append_item(item, bucket=[]):\n    bucket.append(item)\n    return bucket\n"
        },
        "contract": "保持签名与调用方式不变（append_item(x) 与 append_item(x, [9]) 都要可用）"
      },
      "expect": [
        {
          "checker": "python_probes",
          "path": "code",
          "args": {
            "probes": [
              {
                "call": "append_item",
                "args": [
                  1
                ],
                "expected": [
                  1
                ]
              },
              {
                "call": "append_item",
                "args": [
                  2
                ],
                "expected": [
                  2
                ]
              },
              {
                "call": "append_item",
                "args": [
                  3,
                  [
                    9
                  ]
