++class TestDiffPartitions:
++    """磁盘分区 diff：挂载 normal / 卸载 warning。"""
++
++    def test_no_change(self, cd):
++        p = {"C:\\": {"mountpoint": "C:\\", "fstype": "NTFS"}}
