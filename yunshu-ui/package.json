{
  "name": "Yunshu-ui",
  "private": true,
  "version": "0.1.0",
  "description": "云枢 · AI 智能体桌面工作台（Electron + React + Mosaic）",
  "author": "Yunshu Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.yunshu.desktop",
    "productName": "云枢",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**",
      "!dist/storage-test.html",
      "!dist/storage-test.js",
      "!dist-electron/preload.mjs"
    ],
    "asar": true,
    "compression": "maximum",
    "beforePack": "scripts/beforePack.mjs",
    "afterPack": "scripts/afterPack.mjs",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false,
    "electronDownload": {
      "cache": "${env.TEMP}/eb-cache/electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "云枢",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:flask": "npm run build && node -e \"const fs=require('fs'),path=require('path');const dist='dist',flaskStatic=path.join(__dirname,'..','static'),flaskTpl=path.join(__dirname,'..','templates');if(!fs.existsSync(flaskStatic))fs.mkdirSync(flaskStatic,{recursive:true});fs.cpSync(path.join(dist,'index.html'),path.join(flaskTpl,'yunshu.html'),{recursive:true});const assets=fs.readdirSync(path.join(dist,'assets'));assets.forEach(f=>fs.cpSync(path.join(dist,'assets',f),path.join(flaskStatic,'assets',f),{recursive:true}));console.log('✓ React 构建产物已复制到 Flask static/ 和 templates/');\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -b --noEmit",
    "check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "dev:electron": "vite",
    "build:electron": "vite build",
    "dist:electron": "node scripts/dist-electron.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-mosaic-component": "^7.0.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
