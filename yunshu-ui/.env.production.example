# 生产环境配置模板（复制为 .env.production 使用）
# Vite 构建时自动加载 .env.production，此文件仅作为模板提交到仓库
# 使用方式: cp .env.production.example .env.production && 填入真实 DSN
#
# 后端 API 地址：
# - Web 模式（Nginx/Flask 同域部署）必须留空：前端走同域 /api 相对路径，由 Nginx/Flask 代理到后端。
#   实测若写成绝对地址（如 http://127.0.0.1:5678），浏览器直连后端会触发 CORS 失败并绕过 Nginx 代理。
# - Electron 桌面版（file:// 无相对路径）必需绝对地址：打包前命令行注入，例如
#     PowerShell: $env:VITE_API_BASE="http://127.0.0.1:5678"; npm run dist:electron
#     Linux/macOS: VITE_API_BASE=http://127.0.0.1:5678 npm run dist:electron
VITE_API_BASE=
#
# 生产环境：关闭可观测性（tree-shaking 移除）
VITE_OBSERVABILITY_ENABLED=false
VITE_OBS_MAX_RECORDS=200
VITE_OBS_SAMPLING_RATE=0

# Sentry 错误上报（生产环境部署 GlitchTip 后填入 DSN）
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# 用户行为回放采样率（生产环境 1%）
VITE_REPLAY_SAMPLE_RATE=0.01
