# 开发环境：开启可观测性
VITE_OBSERVABILITY_ENABLED=true
VITE_OBS_MAX_RECORDS=200
VITE_OBS_SAMPLING_RATE=1

# 开发环境：日志级别（debug < info < warn < error），控制 src/utils/logger.ts 的输出
VITE_LOG_LEVEL=info

# 开发环境：启用 mock trace_id 注入（无需后端即可验证 DevConsole trace_id 解析）
# 设为 false 则关闭 mock，请求会走真实后端或代理
VITE_MOCK_TRACE=true

# 开发环境：启用本地接口 Mock（拦截 /auth/login、/user/info、/auth/menus，无需后端即可跑通登录流程）
# 真实联调：后端 app_server.py 已实现 /api/auth/login、/api/user/info、/api/auth/menus（按角色下发菜单树）
#           、/api/user/list、DELETE /api/user/:id；置为 false 走真实接口；mock 仅作无后端时的兜底
VITE_MOCK_API=false

# Mock 登录响应是否返回 user 字段：
#   true  → 登录即携带用户信息，MainLayout 跳过初始化拉取（模拟真实后端登录返回 user）
#   false → 登录只返回 token，MainLayout 走"登录后初始化"拉取路径，可验证骨架屏 + 头像展示
VITE_MOCK_LOGIN_RETURN_USER=false

# 开发环境：导出页大数据量 Mock（true 时导出页数据源切换为 5000 条，
# 用于本地验证分片进度条与性能；false 走常规 /user/list 接口）
VITE_EXPORT_LARGE_MOCK=true

# ─────────────────────────────── 后端联调配置（避免 /api 请求 500） ───────────────────────────────
# 500 根因：Vite dev 代理把 /api 转发到目标端口，但目标后端未启动。
# 三种联调方式（按需选择其一）：
#   1) 启动真实后端（python app_server.py，监听 127.0.0.1:5678），下述配置保持默认即可
#   2) 后端不在 5678 / 不在本机时，改 VITE_API_PROXY_TARGET 指向实际地址（dev 代理目标）
VITE_API_PROXY_TARGET=http://127.0.0.1:5678
#   3) 无后端开发时用 mock：把上面 VITE_MOCK_API 改为 true
# 直连后端（不走代理）时设置 VITE_API_BASE（如 http://127.0.0.1:5678，需后端开启 CORS），留空则走 /api 相对路径

# Sentry 错误上报（自建 GlitchTip 后端，留空则禁用）
# 本地开发可不配置；如需联调，使用本地 GlitchTip 实例的 DSN
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=1
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# 用户行为回放（rrweb）采样率
# 默认 1%：仅采样 1% 的会话录制；发生错误时自动 100% 上传最近 30 秒
VITE_REPLAY_SAMPLE_RATE=0.01
