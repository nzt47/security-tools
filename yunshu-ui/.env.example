# ════════════════════════════════════════════════════════════════════════════════
# 云枢 · 环境变量模板
# 用法：复制为 .env（本地默认）、.env.production（生产）后按环境填写。
# 说明：仅 VITE_ 前缀变量会暴露给前端；ELECTRON 供 vite.config 主进程构建读取。
# ════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────── API 地址 ───────────────────────────────
# Web/Flask 同域部署：留空（走相对路径 /api/...，由 Vite 代理或同域提供）
# Electron 桌面版：必须指向后端服务（file:// 下无相对 API），如本地 Flask：
#   VITE_API_BASE=http://127.0.0.1:5678
VITE_API_BASE=

# Vite dev 服务器 /api 代理目标（默认本机 Flask 5678；后端换端口/远程时覆盖）
VITE_API_PROXY_TARGET=http://127.0.0.1:5678

# 本地接口 Mock 开关（dev 下 true 时拦截登录/用户接口，无需后端跑通流程）
VITE_MOCK_API=false

# ─────────────────────────────── 开发服务器 ─────────────────────────────
# Vite dev server 端口（默认 5173，被占用时自动 +1）
VITE_DEV_SERVER_PORT=5173

# 后端 Flask 服务端口（供联调参考，前端不直接读取；SSE 流式接口监听于此）
#   FLASK_SERVER_PORT=5678

# ─────────────────────────────── Electron ───────────────────────────────
# 主进程构建开关：设为 1 时 vite 以 Electron 模式构建
#   （base='./'、启用 vite-plugin-electron 产出 dist-electron/、dev 时自动拉起 Electron）
# 开发 Electron：在终端设置（Windows PowerShell）：
#   $env:ELECTRON="1"; npm run dev
# 或打包（scripts/dist-electron.mjs 内部自动设置）
ELECTRON=0

# Web 联调 mock Electron（双标签页模拟多窗口，见 src/electron/mockElectron.ts）：
# 设为 1 时注入 BroadcastChannel 版 electronAPI，无需真实 Electron 即可联调独立窗口同步
VITE_MOCK_ELECTRON=0

# ─────────────────────────────── 可观测性（可选） ───────────────────────
# Sentry/GlitchTip DSN（留空则不启用错误上报）
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# 性能追踪采样率（0-1，生产建议 0.01）
VITE_SENTRY_TRACES_SAMPLE_RATE=0.01
# 行为回放采样率（0-1，生产建议 0.01 = 1%）
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0.01
# rrweb 录制采样率（0-1，覆盖 Sentry replay，独立控制）
VITE_REPLAY_SAMPLE_RATE=0.01
# 应用版本号（用于 Sentry release 字段）
VITE_APP_VERSION=0.0.0
