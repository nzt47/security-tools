# Dockerfile for Linux Test Environment
#
# 完整测试环境，包含所有依赖：
# - sqlite-vec（KNN 向量检索）
# - torch + sentence-transformers（embedding 模型）
# - transformers（模型推理）
#
# 用途：
#   在 Linux 环境运行所有测试（unit + integration + memory + vector store）
#   解决 Windows 下 torch 0xC0000005 崩溃问题
#
# 用法：
#   docker build -f Dockerfile.linux-test -t yunshu-linux-test .
#   docker run --rm yunshu-linux-test pytest tests/unit/ -v
#   docker run --rm yunshu-linux-test python scripts/verify_768dim_dynamic.py

FROM python:3.12-slim

WORKDIR /app

# ── 国内镜像源配置（加速构建 10-50 倍）──
# apt 源：清华 Debian 镜像
# pip 源：清华 PyPI 镜像
# 注意：python:3.12-slim 基于 Debian trixie，使用 DEB822 格式源文件
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true && \
    mkdir -p /root/.pip && \
    printf '[global]\nindex-url = https://pypi.tuna.tsinghua.edu.cn/simple\ntrusted-host = pypi.tuna.tsinghua.edu.cn\n' > /root/.pip/pip.conf

# ── 系统依赖 ──
# gcc/g++: 编译 C 扩展（sqlite-vec 等）
# git: 部分测试需要
# curl: 健康检查
# sqlite3: 命令行工具（调试用）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# ── Python 依赖 ──
# 先复制依赖文件（利用 Docker 层缓存）
COPY requirements.txt requirements-dev.txt ./

# 安装生产依赖（过滤 Windows-only 包：pywin32/pypiwin32/comtypes）
# 使用清华 PyPI 镜像加速（pip.conf 已配置）
# [修复] 新版 pip 不支持 -r /dev/stdin，改用临时文件
RUN grep -v -E 'pywin32|pypiwin32|comtypes' requirements.txt > /tmp/req-filtered.txt && \
    pip install --no-cache-dir -r /tmp/req-filtered.txt && \
    rm -f /tmp/req-filtered.txt

# 安装开发依赖（pytest, pytest-asyncio, pytest-timeout 等）
# [修复] 过滤 -r requirements.txt 引用行（已在步骤 6 安装，避免 /tmp/ 路径找不到文件）
RUN if [ -f requirements-dev.txt ]; then \
        grep -v -E 'pywin32|pypiwin32|comtypes|^-r ' requirements-dev.txt > /tmp/req-dev-filtered.txt && \
        pip install --no-cache-dir -r /tmp/req-dev-filtered.txt && \
        rm -f /tmp/req-dev-filtered.txt; \
    fi

# 安装项目本身（-e 模式，支持测试导入）
# [修复] 使用 --no-deps 避免 pyproject.toml 版本约束与 requirements.txt 冲突
# pyproject.toml 要求 torch<2.5.0，但 requirements.txt 安装了 torch==2.12.0
# 所有依赖已在 requirements.txt + requirements-dev.txt 中安装，只需安装项目本身
COPY . .
RUN pip install --no-cache-dir --no-deps -e .

# ── 环境变量 ──
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# [torch 稳定性] 限制 OpenMP 线程数，避免过度并发导致的内存访问冲突
# Linux 上 torch 通常稳定，但限制线程数可避免资源竞争
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4

# [HuggingFace 模型缓存] 持久化到卷，避免每次重新下载
# 【不易】缓存根语义必须统一（2026-08-14 实证）：
#   huggingface_hub.snapshot_download(cache_dir=X) 把 X 直接当作 hub 缓存根，
#   模型落在 X/models--<org>--<name>/snapshots/...（X 下不再拼 hub/）。
#   HF_HOME 则是 huggingface_hub 的默认缓存根，HF_HUB_CACHE = {HF_HOME}/hub。
#   vector_store._is_model_fully_cached 检查 {HF_HOME}/hub/models--...。
#   因此 TRANSFORMERS_CACHE / SENTENCE_TRANSFORMERS_HOME（作为显式 cache_dir
#   传入）必须指向 {HF_HOME}/hub，否则模型落盘（{SENTENCE_TRANSFORMERS_HOME}/
#   models--）与检查路径不一致 → 容器内误判无缓存 → 编码器在线加载失败 → 降级 json。
ENV HF_HOME=/app/.hf_cache
ENV TRANSFORMERS_CACHE=/app/.hf_cache/hub
ENV SENTENCE_TRANSFORMERS_HOME=/app/.hf_cache/hub

# [测试配置] 默认超时 120 秒（embedding 模型加载需要时间）
ENV PYTEST_TIMEOUT=120

# 验证关键模块可导入（build 阶段快速失败）
RUN python -c "import sqlite_vec; print(f'sqlite-vec OK: {sqlite_vec.__version__}')" || echo "[WARN] sqlite-vec import failed"
RUN python -c "import torch; print(f'torch OK: {torch.__version__}')" || echo "[WARN] torch import failed"
RUN python -c "import sentence_transformers; print(f'sentence-transformers OK')" || echo "[WARN] sentence-transformers import failed"
RUN python -c "from agent.memory.long_term_memory import LongTermMemory; print('LongTermMemory OK')"

# 创建必要目录
RUN mkdir -p /app/test_results /app/.hf_cache /app/data/memory /app/backups

# ── [新增] 预下载 HuggingFace embedding 模型 ──
# 在 build 阶段预下载模型到镜像中，避免测试时因网络超时失败
# 模型列表：paraphrase-multilingual-MiniLM-L12-v2, all-MiniLM-L6-v2, BAAI/bge-small-zh-v1.5
# 注意：此步骤需要网络访问，如果网络不通会跳过（不阻断构建）
RUN python scripts/predownload_models.py || echo "[WARN] 模型预下载失败，测试时可能需要网络访问"

# ── [新增] 健康检查：验证模型缓存可用 ──
# 检查至少一个模型已缓存，且可加载
HEALTHCHECK --interval=30s --timeout=60s --start-period=10s --retries=3 \
    CMD python -c " \
import os, sys; \
cache = os.environ.get('HF_HOME', '/app/.hf_cache'); \
models_dir = os.path.join(cache, 'models--'); \
cached = [d for d in os.listdir(models_dir) if d.startswith('models--')] if os.path.exists(models_dir) else []; \
print(f'缓存模型数: {len(cached)}'); \
sys.exit(0 if len(cached) > 0 else 1) \
" || exit 1

# 测试结果卷
VOLUME /app/test_results
# 数据卷（测试数据库）
VOLUME /app/data/memory
# 【不易】不再对 /app/.hf_cache 声明匿名卷（原 VOLUME 指令已删除）：
# build 阶段 predownload_models.py 已把模型写入镜像层；docker run 无显式卷挂载时，
# 匿名卷指令会遮蔽镜像层内容（或 save/load 复用后层内容不可见），
# 导致容器内 _is_model_fully_cached 返回 False → 在线加载失败 → 降级 json 后端。
# 模型缓存持久化由 docker-compose.linux-test.yml 显式命名卷（hf-cache）负责。

# 默认运行所有 unit 测试
# [修复] 移除 --timeout/--timeout-method，避免与 pytest.ini addopts 重复冲突
ENTRYPOINT ["python", "-m", "pytest", "tests/unit/", "-v", "--tb=short"]
